@companyId = b141e457-3ed5-4e56-a6cb-d755ca30e10f
@deliveryAreaId = 39a1580f-ed53-4e91-a6e8-a6929e4d8879


### 업체 생성
POST http://localhost:19082/api/v1/companies
Content-Type: application/json

{
  "managerUserId": "11111111-1111-1111-1111-111111111111",
  "name": "테스트 업체11",
  "lotAddress": "서울시 해운대구 가로수길 12",
  "roadAddress": "서울시 해운대구 가로수길 12",
  "description": "HTTP 테스트용 업체"
}

### 업체 목록조회
GET http://localhost:19082/api/v1/companies?page=0&size=10

### 업체 이름 검색
GET http://localhost:19082/api/v1/companies?name=테스트&page=0&size=10

### 업체 상세조회
GET http://localhost:19082/api/v1/companies/{{companyId}}

### 업체 수정
PATCH http://localhost:19082/api/v1/companies/{{companyId}}
Content-Type: application/json

{
  "name": "kafka test 수정된 업체",
  "lotAddress": "함겸북도 베이징 하와이 12",
  "roadAddress": "함겸북도 베이징 하와이 12",
  "description": "kafka 수정 테스트"
}

### 업체 삭제
DELETE http://localhost:19082/api/v1/companies/{{companyId}}



### 업체 배달 가능 지역 생성
POST http://localhost:19082/api/v1/companies/{{companyId}}/delivery-areas
Content-Type: application/json

{
  "region": "GANGNAM",
  "estimatedDeliveryMinutes": 60
}
}

### 업체 배달 가능 지역 목록 조회
GET http://localhost:19082/api/v1/companies/{{companyId}}/delivery-areas

### 업체 배달 가능 지역 수정
PATCH http://localhost:19082/api/v1/companies/{{companyId}}/delivery-areas/{{deliveryAreaId}}
Content-Type: application/json

{
  "region": "SEOCHO",
  "estimatedDeliveryMinutes": 40
}

### 업체 배달 가능 지역 일부 수정 - 시간만 변경
PATCH http://localhost:19082/api/v1/companies/{{companyId}}/delivery-areas/{{deliveryAreaId}}
Content-Type: application/json

{
  "estimatedDeliveryMinutes": 35
}

### 업체 배달 가능 지역 삭제
DELETE http://localhost:19082/api/v1/companies/{{companyId}}/delivery-areas/{{deliveryAreaId}}
