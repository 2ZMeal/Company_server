@deliveryAreaId = 4806c505-c69e-4526-beaf-e2303ed7eefa


### 업체 생성
POST http://localhost:19082/api/v1/companies
Content-Type: application/json
X-User-Id: 11111111-1111-1111-1111-111111111111
X-User-Roles: COMPANY
X-User-Email: rhkrcksghd@naver.com

{
  "name": "테스트 업체43777",
  "lotAddress": "서울시 해운대구 가로수길 12",
  "roadAddress": "서울시 해운대구 가로수길 12",
  "description": "HTTP 테스트용 업체"
}

### 업체 목록조회
GET http://localhost:19082/api/v1/companies?page=0&size=10

### 업체 이름 검색
GET http://localhost:19082/api/v1/companies?name=테스트&page=0&size=10

### 업체 상세조회
GET http://localhost:19082/api/v1/companies/{{companyId}}

### 업체 수정
PATCH http://localhost:19082/api/v1/companies/{{companyId}}
Content-Type: application/json
X-User-Id: 11111111-1111-1111-1111-111111111111
X-User-Role: ADMIN

{
  "name": "kafka test 수정된 업체",
  "lotAddress": "함겸북도 베이징 하와이 12",
  "roadAddress": "함겸북도 베이징 하와이 12",
  "description": "kafka 수정 테스트"
}

### 배송 가능 지역/시간 생성 - 강남구 아침
POST http://localhost:19082/api/v1/companies/{{companyId}}/delivery-areas
Content-Type: application/json

{
  "region": "GANGNAM",
  "mealPeriod": "BREAKFAST",
  "estimatedArrivalStartTime": "07:00",
  "estimatedArrivalEndTime": "08:00"
}


### 배송 가능 지역/시간 생성 - 강남구 점심
POST http://localhost:19082/api/v1/companies/{{companyId}}/delivery-areas
Content-Type: application/json

{
  "region": "GANGNAM",
  "mealPeriod": "LUNCH",
  "estimatedArrivalStartTime": "11:30",
  "estimatedArrivalEndTime": "13:00"
}


### 배송 가능 지역/시간 생성 - 서초구 아침
POST http://localhost:19082/api/v1/companies/{{companyId}}/delivery-areas
Content-Type: application/json

{
  "region": "SEOCHO",
  "mealPeriod": "BREAKFAST",
  "estimatedArrivalStartTime": "07:30",
